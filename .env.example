# PostgreSQL接続文字列（Railwayでは ${{Postgres.DATABASE_URL}} を参照）
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/freeaddressspot
# 外部URL経由でSSL接続する場合のみ 1 を設定（Railway内部ネットワークでは不要）
# PGSSL=1

# Auth.js（`npx auth secret` で生成）
AUTH_SECRET=
# Google OAuthクライアント（リダイレクトURI: https://<ドメイン>/api/auth/callback/google）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# リバースプロキシ配下（Railway等）では必須
AUTH_TRUST_HOST=true

# ログインを許可するメールドメイン（例: example.co.jp。未設定 or * で全ドメイン許可）
ALLOWED_EMAIL_DOMAIN=

# 本番URL（NFCタグ用チェックインURLの生成に使用。ビルド時に焼き込まれる）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /api/cron/reset（深夜リセットの予備経路）の認証トークン
CRON_SECRET=

# ローカル開発のみ: メールアドレスだけでログインできる開発用ログインを有効化
# （productionビルドでは設定しても常に無効）
# ENABLE_DEV_LOGIN=1
